{
  "description": "Allow outgoing connections from Terminal.app to development tooling and the coding agents harness destinations.",
  "name": "Terminal",
  "rules": [
    {
      "priority": "regular",
      "process": "identifier.APPLE/com.apple.Terminal",
      "owner": "any",
      "remote-domains": "agentclientprotocol.com",
