{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format Remotes JSON",
      "type": "shell",
      "command": "node ${workspaceFolder}/scripts/format-remotes.js --format",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
