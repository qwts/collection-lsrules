        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Merge Domains from Clipboard",
      "type": "shell",
      "command": "pbpaste | node ${workspaceFolder}/scripts/format-remotes.js --merge",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
